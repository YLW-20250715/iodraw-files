{"root":{"data":{"id":"dl8oqso7hyg0","created":1788743763363,"text":"2026年9月7号至18号"},"children":[{"data":{"id":"dl8ox3v1ue80","created":1788744257908,"text":"部署本地代码静态扫描","background":"#eaf1dd"},"children":[{"data":{"id":"dl91uln54kg0","created":1788780735947,"text":"拷贝bsp静态脚本及预设文件","background":"#eaf1dd"},"children":[]},{"data":{"id":"dl91v00jdgw0","created":1788780767232,"text":"搭建wsl静态扫描环境","background":"#eaf1dd"},"children":[]},{"data":{"id":"dl91vbc6h140","created":1788780791880,"text":"修改静态扫描脚本","background":"#eaf1dd"},"children":[]},{"data":{"id":"dl91vj0ufwg0","created":1788780808609,"text":"修改heave模块代码格式、命名规范","background":"#eaf1dd"},"children":[]}]},{"data":{"id":"dl8p70j8zvs0","created":1788745034304,"text":"升沉"},"children":[{"data":{"id":"dl9wa2dfkb40","created":1788866581125,"text":"补充单元测试","expandState":"expand"},"children":[{"data":{"id":"dl9w4n4a8jk0","created":1788866156099,"text":"升沉模块测试用例文档补充"},"children":[{"data":{"id":"dl9wdbxi2eo0","created":1788866837022,"text":"1 按模块，先判断原有测试用例的合理性 打上标签"},"children":[]},{"data":{"id":"dl9wdrpmjko0","created":1788866871374,"text":"2 在完成1的及基础上去掉不合理的用例，然后新增需要补充的用例"},"children":[]}]},{"data":{"id":"dl9w5965pvk0","created":1788866204102,"text":"依照测试用例一个一个完成单元测试"},"children":[{"data":{"id":"dl9wejcswao0","created":1788866931549,"text":"1 按模块先完成P0级别的有效等价类用例"},"children":[]},{"data":{"id":"dl9wev5fzv40","created":1788866957225,"text":"2 然后再完成P1 P2级别的边界和无效等价类"},"children":[]}]}]},{"data":{"id":"dl9wacatluo0","created":1788866602735,"text":"现有问题排查","expandState":"expand"},"children":[{"data":{"id":"dl9w969ck0o0","created":1788866511221,"text":"搞清楚延迟升沉窗口位置应该在哪"},"children":[{"data":{"id":"dl9wh1tjlyo0","created":1788867128471,"text":"在最新时刻附近？"},"children":[{"data":{"id":"dla0iwvodvs0","created":1788878558884,"text":"在最新时刻后30s？"},"children":[]}]},{"data":{"id":"dl9wh7ltvkg0","created":1788867141066,"text":"在缓存区中间？"},"children":[{"data":{"id":"dla0iwvodvs0","created":1788878558884,"text":"在缓冲区中间时刻30s？"},"children":[]}]}]},{"data":{"id":"dl9w6z4xerc0","created":1788866338988,"text":"排查升沉估计出现波动的原因"},"children":[{"data":{"id":"dl9ycc5bpag0","created":1788872401351,"text":"搭建一套能输出算法中任意位置变量的机制"},"children":[{"data":{"id":"dla0jlvsrow0","created":1788878613311,"text":"不能影响现有工程构建和后续开发"},"children":[]}]},{"data":{"id":"dl9ycte0nag0","created":1788872438881,"text":"在整个延迟升沉估计的各个节点输出过程数据-青岛、天津所有数据"},"children":[{"data":{"id":"dla0jz8i5ig0","created":1788878642378,"text":"分支主题"},"children":[]}]},{"data":{"id":"dl9yenvz4mg0","created":1788872583635,"text":"在不改变算法的情况下先保存好一套过程数据"},"children":[]},{"data":{"id":"dl9yf6rvyao0","created":1788872624747,"text":"按照控制变量的原则修改一个位置重复处理操作"},"children":[]},{"data":{"id":"dl9yfnvdnz40","created":1788872661963,"text":"对比分析初始结果与修改后的结果"},"children":[]},{"data":{"id":"dl9ygeneac80","created":1788872720253,"text":"总结结论*"},"children":[]}]}]},{"data":{"id":"dl9waeuolqw0","created":1788866608289,"text":"算法优化","expandState":"expand"},"children":[{"data":{"id":"dl9w8qfczug0","created":1788866476756,"text":"计算性能优化"},"children":[{"data":{"id":"dl9ygk6rkmg0","created":1788872732309,"text":"1 滤波窗口缩短 这可能需要做实验测试极限在哪，需要单独出一份实验设计"},"children":[]},{"data":{"id":"dl9yh39wpw80","created":1788872773857,"text":"2 去除一些没必要的过程变量"},"children":[]}]},{"data":{"id":"dl9w8vruz2o0","created":1788866488396,"text":"截止频率自适应"},"children":[{"data":{"id":"dl9yhf3oqxs0","created":1788872799603,"text":"陈琦论文"},"children":[]}]}]},{"data":{"id":"dl9wb0onkuo0","created":1788866655814,"text":"仿真程序MATLAB、Python与现有工程的一致性验证"},"children":[]}]},{"data":{"id":"dl8oxf1gdls0","created":1788744282239,"text":"移植 RTKLIB"},"children":[{"data":{"id":"dl9s6ckc4800","created":1788855005414,"text":"收集RTKLIB衍生工程","background":"#eaf1dd"},"children":[]},{"data":{"id":"dl9s6o72kw00","created":1788855030733,"text":"理清移植RTKLIB到app工程的思路"},"children":[]},{"data":{"id":"dl9s6vte9nk0","created":1788855047320,"text":"实施移植"},"children":[]}]},{"data":{"id":"dl8oxnjjt5s0","created":1788744300747,"text":"调研收集紧组合开源算法仓库"},"children":[{"dat